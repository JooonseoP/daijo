# Normalize line endings: store everything as LF in the repo.
* text=auto eol=lf

# Windows-only scripts must keep CRLF.
*.bat  text eol=crlf
*.cmd  text eol=crlf
*.ps1  text eol=crlf

# Dart/Flutter & common source: explicitly LF.
*.dart   text eol=lf
*.gradle text eol=lf
*.kts    text eol=lf
*.kt     text eol=lf
*.java   text eol=lf
*.xml    text eol=lf
*.yaml   text eol=lf
*.yml    text eol=lf
*.json   text eol=lf
*.md     text eol=lf
*.sh     text eol=lf
gradlew  text eol=lf

# Binary assets: never touch.
*.png    binary
*.jpg    binary
*.jpeg   binary
*.gif    binary
*.webp   binary
*.ico    binary
*.svg    text eol=lf
*.ttf    binary
*.otf    binary
*.woff   binary
*.woff2  binary
*.jar    binary
*.keystore binary
*.jks    binary
*.p12    binary
*.so     binary
*.a      binary
*.dylib  binary
*.dll    binary
*.exe    binary
*.zip    binary
